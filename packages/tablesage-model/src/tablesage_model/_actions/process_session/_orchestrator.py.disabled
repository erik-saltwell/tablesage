from __future__ import annotations

from ... import _paths
from ...io import load_campaign, load_player, load_player_set, load_session
from ...io.transcript_io import save_transcript
from ...protocols import NullIncrementalProgressSink, PhasedProgressEvent, PhasedProgressSink
from ...settings import AppSettings
from ..invalidation import InputChange, invalidate
from ..transcription import clean_audio, generate_summary, identify_speakers, transcribe_and_diarize


class OrphanAttendeeError(Exception):
    def __init__(self, missing_slugs: tuple[str, ...]) -> None:
        self.missing_slugs = missing_slugs
        super().__init__(f"Session attendees reference player slugs not in PlayerSet: {', '.join(missing_slugs)}")


async def _emit(sink: PhasedProgressSink, phase: str) -> None:
    await sink.publish(PhasedProgressEvent(source="process_session", phase=phase))


async def _process_session(
    campaign_slug: str,
    session_slug: str,
    app_settings: AppSettings,
    sink: PhasedProgressSink,
) -> None:
    invalidate(campaign_slug, session_slug, InputChange.PROCESS_SESSION_RERUN, app_settings)

    campaign = load_campaign(campaign_slug)
    session = load_session(campaign_slug, session_slug)
    player_set = load_player_set(campaign_slug)
    known_slugs = {p.slug for p in player_set.players}

    missing = tuple(slug for slug in session.attendees if slug not in known_slugs)
    if missing:
        raise OrphanAttendeeError(missing)

    attendees = [load_player(campaign_slug, slug) for slug in session.attendees]

    await _emit(sink, "cleaning audio")
    await clean_audio(campaign_slug, session_slug, app_settings, sink)

    await _emit(sink, "transcribing and diarizing")
    discourse = await transcribe_and_diarize(campaign_slug, session_slug, app_settings, None, sink)

    await _emit(sink, "identifying speakers")
    discourse = await identify_speakers(campaign_slug, session_slug, app_settings, attendees, discourse, NullIncrementalProgressSink())

    discourse.save(_paths.session_dir(campaign_slug, session_slug) / _paths.KnownFiles.DISCOURSE)
    save_transcript(campaign_slug, session_slug, discourse)

    await _emit(sink, "generating summary")
    await generate_summary(campaign_slug, session_slug, app_settings, campaign.glossary, discourse, sink)
