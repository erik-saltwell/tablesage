from __future__ import annotations

from ..._tools.llm.summary import generate_summary as _tool_generate_summary
from ...model import GlossaryEntry
from ...model.discourse import Discourse
from ...protocols import PhasedProgressEvent, PhasedProgressSink
from ...settings import AppSettings, SummaryGeneratorSettings


async def generate_summary(
    campaign_slug: str,
    session_slug: str,
    app_settings: AppSettings,
    glossary: tuple[GlossaryEntry, ...],
    discourse: Discourse,
    sink: PhasedProgressSink,
) -> None:
    settings: SummaryGeneratorSettings = app_settings.summary_generation
    await sink.publish(PhasedProgressEvent(source="generate_summary", phase="generating summary"))
    markdown = await _tool_generate_summary(discourse, glossary, settings.llm_model)
    settings.summary_file.write_text(markdown)
