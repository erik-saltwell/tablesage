from __future__ import annotations

from pathlib import Path

import pytest
from tablesage_model.pipeline import session as session_pipeline
from tablesage_model.pipeline.session import KnownSessionFiles, SessionState, create_session, get_session_state, import_audio_file
from tablesage_model.settings import AppSettings

pytestmark = pytest.mark.anyio


async def test_create_session_scaffolds_state_and_settings_files(tmp_path: Path) -> None:
    settings = AppSettings(llm_model="openai/gpt-5", clean_clips_on_import=True)
    sessions_dir = tmp_path / "sessions"

    await create_session(settings, "iron-pact-01", sessions_dir)

    session_dir = sessions_dir / "iron-pact-01"
    assert (session_dir / KnownSessionFiles.state_file).read_text(encoding="utf-8") == f"{SessionState.clean.value}\n"
    assert await get_session_state("iron-pact-01", sessions_dir) == SessionState.clean
    assert AppSettings.load(session_dir / KnownSessionFiles.settings_file) == settings


async def test_import_audio_file_copies_matching_format_to_settings_audio_file(tmp_path: Path) -> None:
    settings = AppSettings(cleaned_audio_file=Path("session-audio.wav"))
    sessions_dir = tmp_path / "sessions"
    source_audio = tmp_path / "source.wav"
    source_audio.write_bytes(b"wav-audio")
    await create_session(settings, "iron-pact-01", sessions_dir)

    await import_audio_file(source_audio, "iron-pact-01", sessions_dir)

    session_dir = sessions_dir / "iron-pact-01"
    assert (session_dir / "session-audio.wav").read_bytes() == b"wav-audio"
    assert await get_session_state("iron-pact-01", sessions_dir) == SessionState.audio_imported


async def test_import_audio_file_converts_mismatched_format_with_ffmpeg(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    settings = AppSettings(cleaned_audio_file=Path("converted.wav"))
    sessions_dir = tmp_path / "sessions"
    source_audio = tmp_path / "source.m4a"
    source_audio.write_bytes(b"m4a-audio")
    await create_session(settings, "iron-pact-01", sessions_dir)
    captured: dict[str, list[str]] = {}

    def fake_run_command(cmd: list[str], *, capture_output: bool = False) -> None:
        captured["cmd"] = cmd
        Path(cmd[-1]).write_bytes(b"converted-audio")

    monkeypatch.setattr(session_pipeline, "run_command", fake_run_command)

    await import_audio_file(source_audio, "iron-pact-01", sessions_dir)

    target_path = sessions_dir / "iron-pact-01" / "converted.wav"
    assert target_path.read_bytes() == b"converted-audio"
    assert captured["cmd"] == [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error",
        "-y",
        "-i",
        str(source_audio),
        str(target_path),
    ]
    assert await get_session_state("iron-pact-01", sessions_dir) == SessionState.audio_imported
