{
  "title": "Bullet trial: Generated Session Summary scene bullets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_number",
          "bullets"
        ],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            }
          }
        }
      }
    }
  }
}
