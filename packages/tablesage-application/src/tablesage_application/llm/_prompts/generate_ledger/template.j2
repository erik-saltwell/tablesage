<session_attendees>
{% for attendee in attendees %}- {{ attendee.player_name }}{% if attendee.roles %}: {{ attendee.roles | join(", ") }}{% endif %}
{% endfor %}</session_attendees>

<glossary>
{% for entry in glossary %}- {{ entry.term }}{% if entry.description %}: {{ entry.description }}{% endif %}
{% endfor %}</glossary>

{% if starting_context %}<starting_context>
{{ starting_context }}
</starting_context>

{% endif %}<session_utterances>
{{ session_utterances }}
</session_utterances>
{% if validation_feedback %}

<validation_feedback>
The previous response was rejected. Generate a complete corrected response from the original inputs.
{{ validation_feedback }}
</validation_feedback>
<rejected_candidate>
{{ rejected_candidate | default("") }}
</rejected_candidate>
This candidate is an invalid draft, not an additional factual source. Use the original transcript
to correct it. Return the complete response; do not remove real events to make validation easier.
{% endif %}
