{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "new_assets"
  ],
  "properties": {
    "new_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NewAsset"
      }
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "NewAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "benefit",
        "goal_id",
        "acquired_from_opportunity",
        "goal_support"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "benefit": {
          "type": "string",
          "minLength": 1
        },
        "goal_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^goal_[0-9]+$"
        },
        "impediment_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^impediment_[0-9]+$"
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^opportunity_[0-9]+$"
        },
        "acquired_from_opportunity": {
          "type": "boolean"
        },
        "goal_support": {
          "type": "string",
          "enum": [
            "trivial",
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
