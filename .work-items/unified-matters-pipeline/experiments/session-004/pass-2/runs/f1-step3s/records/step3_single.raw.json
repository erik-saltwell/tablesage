{"threads":[{"id":"thread_1","facts":[{"id":"fact_1","kind":"want","text":"Find the dwarves' hoard that the party's map, Bral's map, leads to.","state":"open","change":"updated","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["prior","beat_74","beat_75"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny said Bral probably hid the dwarves' hoard in the Dragon's Lair cave, which the dwarves had scouted as a hiding spot.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_2"],"importance":"high","actionability":"high","evidence":["beat_77"]},{"id":"fact_new_2","kind":"could_use","text":"Dr. Uriah's Read Languages spell can read the writing under one map location per day.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_19"]},{"id":"fact_new_3","kind":"unknown","text":"What is the one still-unidentified location marked on the map? Sir Phidipaldi guesses King Hogboon's, whose tribe lives in the ruined temple of a forgotten wild god on the way to the Dwarven mine.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"high","evidence":["beat_22","beat_67"]}]},{"id":"thread_2","facts":[{"id":"fact_2","kind":"want","text":"Kill the dragon near Brandonsford for Eric the Reeve's 1000 gold bounty.","state":"open","change":"carried","end