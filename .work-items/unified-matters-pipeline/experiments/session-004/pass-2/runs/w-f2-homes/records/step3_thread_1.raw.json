{"facts":[{"id":"fact_1","kind":"want","text":"Find the treasure marked on the party's map.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["prior"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny's ghost says the map's treasure is the dwarves' hoard from the mine, which they kept back from selling to the town, and that Bral probably hid it at the place the map labels \"Dragon's lair.\"","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_2","also_bears_on":["thread_2","thread_16"],"importance":"high","actionability":"medium","evidence":["beat_74","beat_75","beat_77"]},{"id":"fact_new_2","kind":"could_use","text":"Dr. Uriah can read what is written under one location on the treasure map per day.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"medium","evidence":["beat_17","beat_18","beat_20"]},{"id":"fact_new_3","kind":"threat","text":"The map's unmarked location is a ruined temple to a forgotten wild god, now a castle full of King Hogboon's goblins, near the route to the Dwarven mine; parties passing it may be spotted by the goblins.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_3"],"importance":"low","actionability":"low","evidence":["beat_20","beat_64","beat_65"]}]}