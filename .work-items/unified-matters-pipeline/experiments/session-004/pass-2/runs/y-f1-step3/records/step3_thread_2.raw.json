50","beat_65"]},{"id":"fact_new_4","kind":"could_use","text":"Sir Phidipaldi's plan: dose caught game with faun wine, leave it outside the dragon's cave, wait for the dragon to eat it, then go in.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["beat_52"]},{"id":"fact_new_5","kind":"could_use","text":"The wizard Malzazarik and Lady Hilda have joined the party for the dragon hunt.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_64"]},{"id":"fact_new_6","kind":"unknown","text":"Is there really a dragon at the Dragon's Lair, or is the dragon a ruse to keep people away, as Dunk speculates?","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_1","also_bears_on":[],"importance":"high","actionability":"high","evidence":["beat_77","beat_78"]},{"id":"fact_new_7","kind":"unknown","text":"What did Sir Brandon really do against his dragon? Vivian says the tale is told only by Sir Brandon himself, and the church knows it but will not let her near it.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"medium","evidence":["beat_51","beat_55"]}]}