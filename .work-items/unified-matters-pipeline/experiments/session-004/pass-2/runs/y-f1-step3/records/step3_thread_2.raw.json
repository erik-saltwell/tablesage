{"facts":[{"id":"fact_2","kind":"want","text":"Kill the dragon near Brandonsford for Eric the Reeve's 1000 gold bounty.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["prior"]},{"id":"fact_3","kind":"blocked_by","text":"George says nothing pierces the black dragon's scales; arrows and swords have all failed against them.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["prior"]},{"id":"fact_4","kind":"threat","text":"George says the black dragon will soon fly and doom Brandonsford.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["prior"]},{"id":"fact_5","kind":"could_use","text":"Lady Hilda will join the party against the dragon if they pay her.","state":"ended","change":"ended","ended_how":"used up: Lady Hilda joined the party, recruited with Cedric's promissory note","learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_12","also_bears_on":[],"importance":"medium","actionability":"low","evidence":["prior","beat_64"]},{"id":"fact_6","kind":"could_use","text":"Warwick keeps a magical mithril chain shirt; Dunk says it could help against the dragon.","state":"ended","change":"ended","ended_how":"used up: Warwick lent the shirt and Wayman Tisdale now wears it","learned_this_session":false,"definite_end":null,"possibly_moot":null,"certai