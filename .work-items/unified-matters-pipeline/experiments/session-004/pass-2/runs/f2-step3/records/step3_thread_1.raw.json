{"facts":[{"id":"fact_1","kind":"want","text":"Find the treasure marked on the party's map.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["prior"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny's ghost said Bral probably hid the dwarves' hoard in the cave marked \"Dragon's lair\" on the party's map. The dwarves had scouted it as a hiding spot: very small, just one big room, a place nobody goes.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_2"],"importance":"high","actionability":"high","evidence":["beat_74","beat_75","beat_77"]},{"id":"fact_new_2","kind":"could_use","text":"Dr. Uriah can read one label on the party's map per day. The map, which came from Bral, marks the Dragon's lair, the Dwarven mine and King Hogboon's temple ruins.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_2"],"importance":"medium","actionability":"high","evidence":["beat_17","beat_18","beat_20","beat_65","beat_75"]},{"id":"fact_new_3","kind":"blocked_by","text":"The dragon reported to live at the Dragon's lair stands between the party and the treasure believed to be hidden there.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_2","also_bears_on":["thread_2"],"importance":"medium","actionability":"medium","evidence":["beat_18","beat_77"]}]}