":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_16"],"importance":"high","actionability":"medium","evidence":["beat_77","beat_78"]}]},{"id":"thread_3","facts":[{"id":"fact_8","kind":"want","text":"Clear the evil out of the Barrow Mound for the Free Goblin Society.","state":"ended","change":"ended","ended_how":"replaced: Wayman changed the deal so the goblins keep the upper mound and wall off the stairs","learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"low","evidence":["prior","beat_13","beat_15"]},{"id":"fact_9","kind":"blocked_by","text":"A huge undead with a greatsword in the Barrow Mound stands in the way (see thread_4).","state":"ended","change":"ended","ended_how":"no longer relevant: the want it blocked was replaced","learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_4","also_bears_on":[],"importance":"low","actionability":"low","evidence":["prior","beat_15"]},{"id":"fact_new_8","kind":"owe","text":"Wayman Tisdale promised Snurk never to tell King Hogboon where the Free Goblin Society goblins are.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":false,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"low","evidence":["beat_17"]}]},{"id":"thread_4","facts":[{"id":"fact_10","kind":"threat","text":"Sir Alfred lies incapacitated but not destroyed in the Barrow Mound and may rise to attack anyone who goes back below.","state":"open","change":"updated","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,