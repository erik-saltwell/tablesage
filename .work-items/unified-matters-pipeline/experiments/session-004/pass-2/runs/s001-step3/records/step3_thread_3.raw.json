{"facts":[{"id":"fact_new_1","kind":"want","text":"Kill the black dragon near Brandonsford.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"uncertain","uncertain_reason":"The party never formally took the job. Sir Phidipaldi said they would talk to the Reeve and return for Lady Hilda, but he also told Eric that black dragons don't exist.","about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["beat_10","beat_16"]},{"id":"fact_new_2","kind":"could_use","text":"Eric the Reeve offers 1000 gold to whoever kills the dragon and drags its body into Brandonsford.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_6"],"importance":"high","actionability":"medium","evidence":["beat_16"]},{"id":"fact_new_3","kind":"could_use","text":"The one-armed woodsman George encountered the dragon and describes it as a black dragon, not a big one. Eric says he lives a couple of houses down from the Clumsy Fox and might come to the tavern tonight.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["beat_17"]},{"id":"fact_new_4","kind":"could_use","text":"Lady Hilda's offer to join the dragon hunt for pay could help the party fight the dragon.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_4","also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_10"]},{"id":"fact_new_5","kind":"threat","text":"A black dragon lurks near Brandonsford. It tore off the woodsman George's arm and may harm others.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"medium","evidence":["beat_13","beat_17","beat_29"]},{"id":"fact_new_6","kind":"threat","text":"Farmer Gill's three sons are out hunting the dragon now, and Gill is sure they will bring it back. They may kill it and claim the Reeve's bounty before the party does.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["beat_30"]},{"id":"fact_new_7","kind":"unknown","text":"Where is the dragon to be found outside Brandonsford?","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["beat_17","beat_27","beat_29"]},{"id":"fact_new_8","kind":"unknown","text":"Sir Brandon's dragon was killed and ripped apart centuries ago. Where did this new dragon come from?","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"low","evidence":["beat_28","beat_29"]}]}