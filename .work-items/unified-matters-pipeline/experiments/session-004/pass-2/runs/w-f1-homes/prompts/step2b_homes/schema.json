{
  "title": "SharedSubjects",
  "type": "object",
  "additionalProperties": false,
  "required": ["shared_subjects"],
  "properties": {
    "shared_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "home", "other_threads", "beats", "reason"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "home": {"type": "string", "pattern": "^thread_[0-9]+$"},
          "other_threads": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^thread_[0-9]+$"}},
          "beats": {"type": "array", "items": {"type": "string", "pattern": "^beat_[0-9]+$"}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
