{"facts":[{"id":"fact_1","kind":"want","text":"Find the treasure marked on the party's map.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["prior"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny's ghost said the map is Bral's map of the seven dwarves' mine hoard, the good metal they kept back. He said Bral probably hid it in the Dragon's Lair, a small one-room cave the dwarves once scouted as a hiding spot and found empty.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_2"],"importance":"high","actionability":"medium","evidence":["beat_74","beat_75","beat_77"]},{"id":"fact_new_2","kind":"could_use","text":"The party's map marks the location of the Dragon's Lair, as Dr. Uriah read from the writing under it.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_2"],"importance":"high","actionability":"high","evidence":["beat_20"]},{"id":"fact_new_3","kind":"could_use","text":"Dr. Uriah's Read Languages spell lets him read the writing under one location on the treasure map per day.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_19"]},{"id":"fact_new_4","kind":"unknown","text":"What is the one still-unidentified location marked on the map? Sir Phidipaldi guesses it is King Hogboon's.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"high","evidence":["beat_22","beat_67"]},{"id":"fact_new_5","kind":"blocked_by","text":"The dragon is reported to lair in the Dragon's Lair, where the hoard probably lies, so recovering the treasure likely means facing it.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_2","also_bears_on":[],"importance":"high","actionability":"medium","evidence":["beat_20","beat_77"]}]}