{"facts":[{"id":"fact_1","kind":"want","text":"Find the treasure marked on the party's map.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["prior"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny's ghost said the treasure is the dwarves' hoard from their mine, and that Bral, who made the party's map, probably hid it at the map's Dragon's Lair.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_2","also_bears_on":["thread_2"],"importance":"high","actionability":"medium","evidence":["beat_74","beat_77"]},{"id":"fact_new_2","kind":"unknown","text":"Bral, Grimny's brother, made the treasure map and lost it to Sir Phidipaldi and Dr. Uriah in a gambling bet. Where is Bral now?","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_16"],"importance":"medium","actionability":"low","evidence":["beat_74","beat_75"]},{"id":"fact_new_3","kind":"unknown","text":"What is the map's one remaining unidentified location? Sir Phidipaldi guesses it is King Hogboon's, and the party found Hogboon's goblins living in temple ruins near an unmarked area of the map.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"medium","evidence":["beat_20","beat_65"]},{"id":"fact_new_4","kind":"could_use","text":"Dr. Uriah can read the writing under one location on the treasure map per day.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"high","evidence":["beat_17"]}]}