{"threads":[{"id":"thread_1","facts":[{"id":"fact_1","kind":"want","text":"Find the treasure marked on the party's map.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["prior"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny says his brother Bral, from whom the party won the map, probably hid the dwarves' mine hoard at the map's Dragon's Lair cave.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":"thread_2","also_bears_on":["thread_16"],"importance":"high","actionability":"high","evidence":["beat_74","beat_75","beat_77"]},{"id":"fact_new_2","kind":"could_use","text":"Dr. Uriah can now read the label under one location on the treasure map per day.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"low","actionability":"medium","evidence":["beat_17"]}]},{"id":"thread_2","facts":[{"id":"fact_2","kind":"want","text":"Kill the dragon near Brandonsford for Eric the Reeve's 1000 gold bounty.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["prior"]},{"id":"fact_3","kind":"blocked_by","text":"George says nothing pierces the black dragon's scales; arrows and swords have all failed against them.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","unce