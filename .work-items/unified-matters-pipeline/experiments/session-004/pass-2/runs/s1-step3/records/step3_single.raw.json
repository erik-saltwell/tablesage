{"threads":[{"id":"thread_1","facts":[{"id":"fact_1","kind":"want","text":"Find the treasure marked on the party's map.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"medium","evidence":["prior"]},{"id":"fact_new_1","kind":"could_use","text":"Grimny says Bral, the dwarf who lost the map to the party, probably hid the map's treasure in the Dragon's Lair.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":["thread_2","thread_16"],"importance":"high","actionability":"medium","evidence":["beat_58","beat_59","beat_60"]},{"id":"fact_new_2","kind":"could_use","text":"Dr. Uriah's Read Languages spell reveals the writing under one treasure-map location per day.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_14"]},{"id":"fact_new_3","kind":"unknown","text":"What does the one still-unidentified location on the map mark? Sir Phidipaldi guesses King Hogboon's, whose goblin castle in a ruined temple lies near an unmarked area of the map.","state":"open","change":"new","ended_how":null,"learned_this_session":true,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_16","beat_50"]}]},{"id":"thread_2","facts":[{"id":"fact_2","kind":"want","text":"Kill the dragon near Brandonsford for Eric the Reeve's 1000 gold bounty.","state":"open","change":"carried","ended_how":null,"learned_th