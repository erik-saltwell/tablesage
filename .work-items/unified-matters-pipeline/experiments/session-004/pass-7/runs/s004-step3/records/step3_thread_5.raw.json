{"facts":[{"id":"fact_62","kind":"could_use","text":"Drop Dead Ned, a killer with a little killer wasp, is hired by the party for a 100 gold fee and travels with them, scouting ahead and carrying tools such as a crowbar.","state":"open","change":"carried","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["prior","beat_7"],"classification":{"serves_thread":"","significance":null,"commitment_type":null,"stake_basis":"","stake":null,"burden":null,"consequence":null,"blocks_thread":"","in_effect":null,"form":"asset","helps_thread":"thread_3","role":"direct","support_basis":"Ned is a hired combatant and scout whose wasp just incapacitated the undead knight Sir Alfred, a capability that could help against the dragon hunt's dangers, though no use against the dragon itself is established.","goal_support":"low","action_basis":"","action_supported":null,"acquired_by_acting_on_opening":true,"grounding_justification":"","grounding":null,"investigative_depth_justification":"","investigative_depth":null,"narrative_payoff_justification":"","narrative_payoff":null,"investigative_potential_justification":"","investigative_potential":null,"question_type":null,"harm_origin":null,"negative_outcome_clarity_justification":"","negative_outcome_clarity":null,"outcome_severity_justification":"","outcome_severity":null,"evidentiary_strength_justification":"","evidentiary_strength":null,"evidence_of_progression_justification":"","evidence_of_progression":null,"preventability_justification":"","preventability":null,"scope_basis":"","persists_beyond_scene":false},"resource_subject":""},{"id":"fact_63","kind":"could_use","text":"Ned pays the party 10 gold back each time they let him murder somebody, provided he may do whatever he wants with the body.","state":"open","change":"carried","ended_how":null,"learned_this_