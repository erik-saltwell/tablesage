{
  "title": "TableRecap",
  "type": "object",
  "additionalProperties": false,
  "required": ["threads", "closing"],
  "properties": {
    "threads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {"label": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}
      }
    },
    "closing": {"type": "string", "minLength": 1}
  }
}
