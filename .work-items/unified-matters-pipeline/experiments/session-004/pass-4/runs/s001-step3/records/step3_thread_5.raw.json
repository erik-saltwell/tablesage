{"facts":[{"id":"fact_new_1","kind":"could_use","text":"Drop Dead Ned, a thief with a killer wasp in a jar on his necklace, offers himself and the wasp for hire at 100 gold a week, as long as he gets to kill people with the wasp. For a night of at least ten kills, he would give back 5 gold per kill if he can do what he wants with the bodies. Dr. Uriah said he would think about it.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"medium","actionability":"high","evidence":["beat_12","beat_22","beat_23","beat_24"],"classification":{"serves_thread":"","significance":null,"commitment":null,"commitment_type":null,"stake_basis":"","stake":null,"burden":null,"consequence":null,"blocks_thread":"","in_effect":null,"form":"opening","helps_thread":"","role":null,"support_basis":"Ned would add a willing killer and his wasp to the party, but play has not tied his hire to any want or debt, and his terms demand killing and the bodies.","goal_support":"low","acquired_by_acting_on_opening":false,"grounding_justification":"","grounding":null,"investigative_depth_justification":"","investigative_depth":null,"narrative_payoff_justification":"","narrative_payoff":null,"investigative_potential_justification":"","investigative_potential":null,"question_type":null,"harm_origin":null,"negative_outcome_clarity_justification":"","negative_outcome_clarity":null,"outcome_severity_justification":"","outcome_severity":null,"evidentiary_strength_justification":"","evidentiary_strength":null,"evidence_of_progression_justification":"","evidence_of_progression":null,"preventability_justification":"","preventability":null}}]}