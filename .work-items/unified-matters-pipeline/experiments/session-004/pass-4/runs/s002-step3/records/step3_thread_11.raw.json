{"facts":[{"id":"fact_new_1","kind":"could_use","text":"Ingrid is brewing a sleeping potion from the faun wine Dunk gave her. Dunk plans to use it to keep Warwick asleep while he gets into the house. He is due to collect it tonight.","state":"open","change":"new","ended_how":null,"learned_this_session":false,"definite_end":null,"possibly_moot":null,"certainty":"established","uncertain_reason":null,"about_thread":null,"also_bears_on":[],"importance":"high","actionability":"high","evidence":["beat_37","beat_38","beat_83","beat_84"],"classification":{"serves_thread":"","significance":null,"commitment":null,"commitment_type":null,"stake_basis":"","stake":null,"burden":null,"consequence":null,"blocks_thread":"","in_effect":null,"form":"opening","helps_thread":"thread_8","role":"step","support_basis":"A sleeping Warwick would let Dunk enter the house and reach the mithril shirt unopposed. It is doubtful whether the potion will work, because the faun wine was heavily diluted and Father William claims Ingrid cannot make her potions herself.","goal_support":"medium","acquired_by_acting_on_opening":false,"grounding_justification":"","grounding":null,"investigative_depth_justification":"","investigative_depth":null,"narrative_payoff_justification":"","narrative_payoff":null,"investigative_potential_justification":"","investigative_potential":null,"question_type":null,"harm_origin":null,"negative_outcome_clarity_justification":"","negative_outcome_clarity":null,"outcome_severity_justification":"","outcome_severity":null,"evidentiary_strength_justification":"","evidentiary_strength":null,"evidence_of_progression_justification":"","evidence_of_progression":null,"preventability_justification":"","preventability":null}},{"id":"fact_new_2","kind":"owe","text":"In exchange for Ingrid making the sleeping potion, Dunk is to meet her tonight and help her get into Warwick's house and dose him, so she can watch Warwick all night without fear of waking him.","state":"open","change":"new","