{
  "title": "SessionChanges",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "change", "impact_basis", "narrative_impact", "lasting_basis", "lasting_consequence"],
        "properties": {
          "id": {"type": "string", "pattern": "^(thread|beat)_[0-9]+$"},
          "change": {"type": "string", "minLength": 1},
          "impact_basis": {"type": "string", "minLength": 1},
          "narrative_impact": {"enum": ["none", "low", "medium", "high"]},
          "lasting_basis": {"type": "string", "minLength": 1},
          "lasting_consequence": {"enum": ["none", "low", "medium", "high"]}
        }
      }
    }
  }
}
