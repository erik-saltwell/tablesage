{
  "title": "ScenesAndBeats",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "description": "The Session's scenes in order.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Scene"}
    }
  },
  "$defs": {
    "Text": {"type": "string", "minLength": 1},
    "Scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "people", "cue", "beats"],
      "properties": {
        "location": {"$ref": "#/$defs/Text"},
        "people": {
          "type": "object",
          "additionalProperties": false,
          "required": ["party", "others"],
          "properties": {
            "party": {"type": "array", "items": {"$ref": "#/$defs/Text"}},
            "others": {"type": "array", "items": {"$ref": "#/$defs/Text"}}
          }
        },
        "cue": {"$ref": "#/$defs/Text"},
        "beats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Beat"}}
      }
    },
    "Beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "importance", "ledger"],
      "properties": {
        "kind": {"enum": ["event", "learned"]},
        "text": {"$ref": "#/$defs/Text"},
        "importance": {"enum": ["high", "medium", "low"]},
        "ledger": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
