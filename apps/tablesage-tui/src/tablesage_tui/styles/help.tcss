
#help-content {
    align: center middle;
    content-align: center middle;
    height: 1fr;
}

#help-panel {
    min-height: 24;
    height: 100%;
    background: $panel-bg;
    border: $sage-glow;
    border-title-align: left;
    border-title-color: $sage-glow;
    border-title-style: bold;
    margin: 4 8 4 8;
    max-width: 120;

    #help-panel-content {
        width: 72;
        height: 100%;
        color: $sage-deep;
        align: center top;

        .help-title {
            height: 1;
            width: 100%;
            margin: 2 0 1 0;
            color: $accent-cream;
            text-style: bold;
            content-align: center middle;
        }

        .help-copy {
            height: 1;
            width: 100%;
            margin: 0 0 2 0;
            color: $sage-glow;
            content-align: center middle;
        }

        .help-bindings {
            height: auto;
            width: 56;
        }

        .help-binding-row {
            height: 1;
            width: 100%;
            margin: 0 0 1 0;
        }

        .help-key {
            margin: 0 2 0 0;
        }

        .help-binding-description {
            height: 1;
            width: 1fr;
            color: $cream-fg;
            content-align: left middle;
        }

        .bottom-spacer {
            min-height: 0;
            height: 1fr;
        }

        .help-note {
            height: 1;
            width: 100%;
            margin: 0 0 1 0;
            color: $sage-glow;
            text-style: italic;
            content-align: center middle;
        }
    }
}