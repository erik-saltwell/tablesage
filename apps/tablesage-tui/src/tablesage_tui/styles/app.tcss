/* TableSage application stylesheet */

/* ******************************** */
/*          color palette           */
/* ******************************** */

/*
 * Raw colors describe appearance, not purpose.
 * Components should use the semantic variables below.
 */

$pine-950:  #090d0a;
$pine-900:  #0f1411;
$pine-800:  #171e19;
$pine-700:  #222a25;
$pine-600:  #2a342d;

$stone-500: #8f988b;
$cream-200: #d6d1bf;

$sage-400:  #a3b88c;
$sage-600:  #6f8a5a;

$amber-600: #a9793c;
$amber-400: #d8b06a;
$red-400:   #b87878;

/* ******************************** */
/*           surface colors         */
/* ******************************** */

/* Terminal canvas */
$surface-0-bg: $pine-950;
$surface-0-fg: $stone-500;

/* Application screen */
$surface-1-bg: $pine-900;
$surface-1-fg: $cream-200;

/* Panel or inlay */
$surface-2-bg: $pine-800;
$surface-2-fg: $cream-200;

/* Nested inlay */
$surface-3-bg: $pine-700;
$surface-3-fg: $cream-200;

$surface-border: $pine-600;

/* ******************************** */
/*        shared content colors      */
/* ******************************** */

$fg-muted:   $stone-500;
$fg-accent:  $sage-400;
$fg-warning: $amber-400;
$fg-danger:  $red-400;

/* ******************************** */
/*       shared interaction states   */
/* ******************************** */

$selected-bg: $sage-600;
$selected-fg: $pine-950;

/* ******************************** */
/*           control colors          */
/* ******************************** */

/* Resting */
$control-bg:     $surface-3-bg;
$control-fg:     $surface-3-fg;
$control-border: $surface-border;

/* Supporting text */
$control-placeholder-fg: $fg-muted;

/* Hover */
$control-hover-bg: $pine-600;
$control-hover-fg: $cream-200;

/* Focus */
$control-focus-bg:     $control-bg;
$control-focus-fg:     $control-fg;
$control-focus-border: $sage-400;

/* Disabled */
$control-disabled-bg: $control-bg;
$control-disabled-fg: $fg-muted;

/* Invalid */
$control-invalid-border: $fg-danger;

/* ******************************** */
/*             overlays              */
/* ******************************** */

$overlay-bg: rgba(9, 13, 10, 0.72);

/* ******************************** */
/*          surface mappings         */
/* ******************************** */

Screen,
.surface-0 {
    background: $surface-0-bg;
    color: $surface-0-fg;
}

.surface-1 {
    background: $surface-1-bg;
    color: $surface-1-fg;
}

.surface-2 {
    background: $surface-2-bg;
    color: $surface-2-fg;
}

.surface-3 {
    background: $surface-3-bg;
    color: $surface-3-fg;
}

/* ******************************** */
/*        application shell         */
/* ******************************** */

.app-frame {
    margin: 1 2;
}

.screen-body {
    background: transparent;
}

TableSageHeader {
    width: 1fr;
    height: 1;
    min-height: 1;
    layout: horizontal;

    background: $selected-bg;
    color: $selected-fg;

    .brand-panel,
    .info-panel {
        width: 1fr;
        height: 1;
    }

    .brand-panel {
        align: left middle;
    }

    .info-panel {
        align: right middle;
    }

    Static {
        width: auto;
        height: 1;
        color: $selected-fg;
        content-align: center middle;
    }

    .brand {
        padding: 0 1;
        background: $fg-accent;
        color: $selected-fg;
        text-style: bold;
    }

    .header-context {
        margin: 0 0 0 1;
    }

    .header-campaign,
    .clock {
        margin: 0 1 0 0;
    }
}

Footer {
    height: 1;
    min-height: 1;
    padding: 0 1;

    background: $surface-2-bg;
    color: $surface-2-fg;

    FooterKey {
        width: auto;
        height: 1;
        margin: 0 2 0 0;

        background: $surface-2-bg;
        color: $surface-2-fg;

        .footer-key--key {
            padding: 0 1;
            background: $fg-warning;
            color: $selected-fg;
            text-style: bold;
        }

        .footer-key--description {
            padding: 0 1 0 1;
            background: $surface-2-bg;
            color: $surface-2-fg;
        }

        &:hover {
            background: $control-hover-bg;

            .footer-key--description {
                background: $control-hover-bg;
                color: $control-hover-fg;
            }
        }

        &.-disabled {
            opacity: 0.5;
        }
    }
    FooterKey:last-child {
        dock: right;
    }

    FooterLabel {
        background: $surface-2-bg;
        color: $surface-2-fg;
    }
}

/* ******************************** */
/*             widgets              */
/* ******************************** */

.panel {
    padding: 1 2;
    border: solid $surface-border;

    border-title-align: left;
    border-title-color: $fg-accent;
    border-title-style: bold;
}

CommandButton {
    width: auto;
    height: 1;
    min-height: 1;

    background: transparent;
    color: $control-placeholder-fg;
    pointer: pointer;

    Static {
        width: auto;
        height: 1;
    }

    .keycap {
        width: auto;
        min-width: 3;
        height: 1;
        min-height: 1;
        padding: 0 1;

        background: $fg-warning;
        color: $selected-fg;
        content-align: center middle;
        text-style: bold;
    }
}

CommandButton:hover,
 {
    background: $control-hover-bg;
    color: $control-hover-fg;
}

CommandButton.-active {
    background: $selected-bg;
    color: $selected-fg;
}

CommandButton:disabled {
    color: $control-disabled-fg;
    opacity: 0.5;
    pointer: not-allowed;
}

/* ******************************** */
/*         landing screen           */
/* ******************************** */

LandingScreen {
    .screen-body {
        align: center middle;
    }

    #welcome-panel {
        width: 80;
        height: 30;

        #welcome-content {
            width: 100%;
            height: 100%;
            align: center top;
        }

        #welcome-lockup {
            width: auto;
            height: auto;
            margin: 1 0 0 0;

            layout: grid;
            grid-size: 2 2;
            grid-columns: auto auto;
            grid-rows: auto 6;

            #logo-spacer {
                width: auto;
                height: auto;
            }

            #welcome-logo {
                width: 100%;
                height: auto;

                content-align: center middle;
                text-wrap: nowrap;
                padding-bottom: 1;
                padding-top: 1;
            }

            #table-wordmark,
            #sage-wordmark {
                width: auto;
                height: 6;

                content-align: left bottom;
                text-wrap: nowrap;
            }

            #table-wordmark {
                color: $fg-accent;
                
            }

            #sage-wordmark {
                color: $surface-2-fg;
            }
        }

        #welcome-tagline {
            width: auto;
            height: 1;
            margin: 1 0 0 0;
            color: $fg-muted;
        }

        #welcome-divider {
            width: auto;
            height: 1;
            margin: 1 0;
            color: $surface-border;
            text-wrap: nowrap;
        }

        .call-to-action {
            width: 47;
            height: 1;
            content-align: center middle;
            align: center middle;
            margin-top: 2;
        }
        
    }
}
