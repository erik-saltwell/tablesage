/* ******************************** */
/*           constants              */
/* ******************************** */

$bg:        #0f1411; 
$panel-bg:  #1a201c;  /* bordered panel fill           */
$border:    #2a342d;  /* panel + footer hairlines      */
$bg-focus:  #222a25;  /* halfway between panel-bg + border */
$bg-focus-subtle: #1e2520; 
$cream-fg:      #d6d1bf;  /* warm cream body text          */
$dim:       #7c8478;  /* secondary / hint copy         */
$sage:      #a3b88c;  /* primary sage green            */
$sage-deep: #6f8a5a;  /* header bar fill               */
$sage-glow: rgba(163, 184, 140, 0.45);
$accent:    #d8b06a;  /* footer keycaps, key chips     */
$panel-bg-muted: #1a201cbb;
$accent-soft: #d7c195; /* halfway between cream-fg and accent */
$accent-cream: #d7c9aa; /* halfway between $accent-soft and $cream-fg*/


/* ******************************** */
/*             reset                */
/* ******************************** */

* {
    margin: 0;
    padding: 0;
}

/* ******************************** */
/*               common             */
/********************************** */
Screen {
    background: $bg;
}

Footer {
    background: $panel-bg;
    row-span: 1;
    column-span: 3;
}

.keycap{
    width: 3;
    height: 1;
    min-height:1;
    min-width:3;
    background: $accent;
    color: $panel-bg;
    text-style: bold;
    content-align: center middle;
}

#main-content {
    align: center middle;
    content-align: center middle;
    height: 1fr;
}

/* ******************************** */
/*             widgets              */
/* ******************************** */

TableSageHeader {
    height: 1;
    row-span: 1;
    column-span: 3;
    background: $sage-deep;
    color: $panel-bg-muted;
    layout: horizontal;

    .brand-panel{
        width:1fr;
        align: left middle;
        
        * {
            width:auto;
            margin: 0 0 0 2;
        }
        .brand{
            margin: 0 0 0 2;
            text-style: bold;
            color: $bg;
        }
    }
    .info-panel{
        width:1fr;
        align: right middle;
        * {
            width: auto;
            margin: 0 2 0 0;
        }
        .clock{

        }
    }   
}

CommandButton {
    width: auto;
    height: 1;
    min-height: 1;
    padding: 0 1;
    color: $sage-deep;
    background: transparent;
    content-align: center middle;
    pointer: pointer;

    Static {
        width: auto;
        height: 1;
    }
}

CommandButton:hover,
CommandButton:focus {
    background: $bg-focus;
    color: $cream-fg;
}

CommandButton:hover .keycap,
CommandButton:focus .keycap {
    background: $accent-cream;
    color: $bg;
}

CommandButton.-active {
    background: $sage-deep;
    color: $bg;
}

CommandButton.-active .keycap {
    background: $panel-bg;
    color: $accent;
}

CommandButton:disabled {
    color: $dim;
    text-opacity: 60%;
    pointer: not-allowed;
}

CommandButton:disabled .keycap {
    background: $border;
    color: $dim;
}


/* ******************************** */
/*           base screen            */
/* ******************************** */

Footer {
    background: $panel-bg;
    row-span: 1;
    column-span: 3;
}


/* ******************************** */
/*           no campaigns           */
/* ******************************** */



#splash-panel {
    height:35;
    background: $panel-bg;
    border: $sage-glow;
    border-title-align: left;
    border-title-color: $sage-glow;
    border-title-style: bold;
    margin:  4 8 4 8;
    max-width: 120;

    #splash-panel-content {
        width:88;
        height:100%;

        #logo {
            content-align: right middle;
            color: $sage-deep;
            height: 8;
            margin: 2 0 0 0;
            padding: 0 20 0 0;
            width:100%
        }
        .wordmark{
            height:6;
            margin: 0 0 1 0;
            width:100%;
            text-wrap: nowrap;
            
            #tablemark {
                color:$sage-deep;
                width:1fr;
                content-align: right bottom;
                height:100%;
                text-wrap: nowrap;
            }
            #sagemark {
                color: $accent-cream;
                width: 1fr;
                content-align: left bottom;
                height:100%;
                text-wrap: nowrap;
            }
        }
        .subtitle{
            height: 1;
            width:100%;
            color:$sage-glow;
            text-style: italic;
            .campaigns{
                content-align: right middle;
                width: 1fr;
                height: 100%;
                margin: 0 2 0 0;
            }
            .intelligent{
                content-align: left middle;
                width: 1fr;
                height: 100%;
            }
        }
        .divider{
            content-align: center middle;
            margin: 2 0 0 0;
            color: $sage-deep;
            text-style: italic;
        }
        .bottom-spacer {
            min-height:1;
            max-height: 50;
            height:1fr;
        }
    }

    .call-to-action{
        margin: 1 0 0 0;
        height: 1;
        width:auto;
        content-align: center middle;
    }

    .commmon-actions{
        margin: 6 0 1 0;
        height: 1;
        width: auto;
        content-align: center middle;

        CommandButton.splash-command {
            margin: 0 6 0 0;
        }

        CommandButton.splash-command .keycap {
            margin: 0 1 0 0;
        }

        #help-command {
            margin: 0;
        }
    }
}

/* ******************************** */
/*               help               */
/* ******************************** */


#help-content {
    align: center middle;
    content-align: center middle;
    height: 1fr;
}

#help-panel {
    min-height: 24;
    height: 100%;
    background: $panel-bg;
    border: $sage-glow;
    border-title-align: left;
    border-title-color: $sage-glow;
    border-title-style: bold;
    margin: 4 8 4 8;
    max-width: 120;

    #help-panel-content {
        width: 72;
        height: 100%;
        color: $sage-deep;
        align: center top;

        .help-title {
            height: 1;
            width: 100%;
            margin: 2 0 1 0;
            color: $accent-cream;
            text-style: bold;
            content-align: center middle;
        }

        .help-copy {
            height: 1;
            width: 100%;
            margin: 0 0 2 0;
            color: $sage-glow;
            content-align: center middle;
        }

        .help-bindings {
            height: auto;
            width: 56;
        }

        .help-binding-row {
            height: 1;
            width: 100%;
            margin: 0 0 1 0;
        }

        .help-key {
            margin: 0 2 0 0;
        }

        .help-binding-description {
            height: 1;
            width: 1fr;
            color: $cream-fg;
            content-align: left middle;
        }

        .bottom-spacer {
            min-height: 0;
            height: 1fr;
        }

        .help-note {
            height: 1;
            width: 100%;
            margin: 0 0 1 0;
            color: $sage-glow;
            text-style: italic;
            content-align: center middle;
        }
    }
}