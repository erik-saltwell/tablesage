/* TableSage application stylesheet */

/* ******************************** */
/*          color palette           */
/* ******************************** */

/*
 * Raw colors describe appearance, not purpose.
 * Components should use the semantic variables below.
 */

$pine-950:  #090d0a;
$pine-900:  #0f1411;
$pine-850:  #131915;
$pine-800:  #171e19;
$pine-750:  #1d241f;
$pine-700:  #222a25;
$pine-600:  #2a342d;

$stone-500: #8f988b;
$cream-200: #d6d1bf;

$sage-200:  #d7e6be;
$sage-400:  #a3b88c;
$sage-600:  #6f8a5a;
$sage-700:  #5b714a;
$sage-800:  #485a3b;
$sage-850:  #3c4a34;
$sage-900:  #35442d;

$amber-600: #a9793c;
$amber-400: #d8b06a;
$red-400:   #b87878;

/* ******************************** */
/*           surface colors         */
/* ******************************** */

/* Terminal canvas */
$surface-0-bg: $pine-950;
$surface-0-fg: $stone-500;

/* Application screen */
$surface-1-bg: $pine-900;
$surface-1-fg: $cream-200;

/* Panel or inlay */
$surface-2-bg: $pine-800;
$surface-2-fg: $cream-200;

/* Nested inlay */
$surface-3-bg: $pine-700;
$surface-3-fg: $cream-200;

$surface-border: $sage-700;

/* ******************************** */
/*        shared content colors      */
/* ******************************** */

$fg-muted:   $stone-500;
$fg-accent:  $sage-400;
$fg-warning: $amber-400;
$fg-danger:  $red-400;

/* ******************************** */
/*       shared interaction states   */
/* ******************************** */

$selected-bg: $sage-600;
$selected-fg: $pine-950;

/* ******************************** */
/*           control colors          */
/* ******************************** */

/* Resting */
$control-bg:     $pine-800;
$control-fg:     $surface-1-fg;
$control-border: $sage-600;

/* Supporting text */
$control-placeholder-fg: $fg-muted;

/* Hover */
$control-hover-bg: $surface-3-bg;
$control-hover-fg: $surface-3-fg;

/* Focus */
$control-focus-bg:     $control-bg;
$control-focus-fg:     $control-fg;
$control-focus-border: $sage-400;

/* Disabled */
$control-disabled-bg: $control-bg;
$control-disabled-fg: $fg-muted;

/* Invalid */
$control-invalid-border: $fg-danger;

/* ******************************** */
/*            button colors          */
/* ******************************** */

/* One identity color per variant -- text and border always match it (see Button,
   below); only the resting background and the -active/disabled states diverge from
   it, and those are expressed directly as percentages/overrides of this same color
   rather than as separate named tokens. */
$button-bg:         transparent;
$button-fg:         $sage-400;
$button-primary-fg: $sage-200;

/* ******************************** */
/*             overlays              */
/* ******************************** */

$overlay-bg: rgba(9, 13, 10, 0.72);

/* ******************************** */
/*          surface mappings         */
/* ******************************** */

Screen {
    background: $surface-0-bg;
    color: $surface-2-fg;

    scrollbar-background: $surface-2-bg;
    scrollbar-background-hover: $surface-3-bg;
    scrollbar-background-active: $surface-3-bg;
    scrollbar-color: $sage-700;
    scrollbar-color-hover: $sage-600;
    scrollbar-color-active: $sage-400;
    scrollbar-corner-color: $surface-2-bg;
}

/* ******************************** */
/*       glossary review screen     */
/* ******************************** */

GlossaryReviewScreen {
    .screen-body {
        padding: 1 2;
    }

    #glossary-review-panel {
        width: 1fr;
        height: 1fr;
    }
}

/* Widget's own DEFAULT_CSS gives every widget an explicit scrollbar-* value
   (Textual's built-in $scrollbar* theme tokens), so the Screen-level rule
   above never actually cascades down -- DataTable (the only scrollable
   widget in this app) needs its own override to pick up our palette. */
DataTable {
    scrollbar-background: $surface-2-bg;
    scrollbar-background-hover: $surface-3-bg;
    scrollbar-background-active: $surface-3-bg;
    scrollbar-color: $sage-700;
    scrollbar-color-hover: $sage-600;
    scrollbar-color-active: $sage-400;
    scrollbar-corner-color: $surface-2-bg;
}

.surface-0 {
    background: $surface-0-bg;
    color: $surface-0-fg;
}

.surface-1 {
    background: $surface-1-bg;
    color: $surface-1-fg;
}

.surface-2 {
    background: $surface-2-bg;
    color: $surface-2-fg;
}

.surface-3 {
    background: $surface-3-bg;
    color: $surface-3-fg;
}

/* ******************************** */
/*        application shell         */
/* ******************************** */

.app-frame {
    margin: 1 2;
}

.screen-body {
    background: transparent;
}

TableSageHeader {
    width: 1fr;
    height: 1;
    min-height: 1;
    layout: horizontal;

    background: $selected-bg;
    color: $selected-fg;

    .brand-panel,
    .info-panel {
        width: 1fr;
        height: 1;
    }

    .brand-panel {
        align: left middle;
    }

    .info-panel {
        align: right middle;
    }

    Static {
        width: auto;
        height: 1;
        color: $selected-fg;
        content-align: center middle;
    }

    .brand {
        padding: 0 1;
        background: $fg-accent;
        color: $selected-fg;
        text-style: bold;
    }

    .header-context {
        margin: 1 0 0 1;
    }

    .header-campaign,
    .clock {
        margin: 0 1 0 0;
    }
}

Footer {
    height: 1;
    min-height: 1;
    padding: 0 1;

    background: $surface-2-bg;
    color: $surface-2-fg;

    FooterKey {
        width: auto;
        height: 1;
        margin: 0 2 0 0;

        background: $surface-2-bg;
        color: $surface-2-fg;

        .footer-key--key {
            padding: 0 1;
            background: $fg-warning;
            color: $selected-fg;
            text-style: bold;
        }

        .footer-key--description {
            padding: 0 1 0 1;
            background: $surface-2-bg;
            color: $surface-2-fg;
        }

        &:hover {
            background: $control-hover-bg;

            .footer-key--description {
                background: $control-hover-bg;
                color: $control-hover-fg;
            }
        }

        &.-disabled {
            opacity: 0.5;
        }
    }
    FooterLabel {
        background: $surface-2-bg;
        color: $surface-2-fg;
    }
}

/* ******************************** */
/*             widgets              */
/* ******************************** */

.panel {
    padding: 1 2;
    border: solid $surface-border;

    border-title-align: left;
    border-title-color: $fg-accent;
    border-title-style: bold;
}

CommandButton {
    width: auto;
    height: 1;
    min-height: 1;

    background: transparent;
    color: $control-placeholder-fg;
    pointer: pointer;

    Static {
        width: auto;
        height: 1;
    }

    .keycap {
        width: auto;
        min-width: 3;
        height: 1;
        min-height: 1;
        padding: 0 1;

        background: $fg-warning;
        color: $selected-fg;
        content-align: center middle;
        text-style: bold;
    }
}

CommandButton:hover,
 {
    background: $control-hover-bg;
    color: $control-hover-fg;
}

CommandButton.-active {
    background: $selected-bg;
    color: $selected-fg;
}

CommandButton:disabled {
    color: $control-disabled-fg;
    opacity: 0.5;
    pointer: not-allowed;
}

/* ******************************** */
/*          common controls         */
/* ******************************** */

Input {
    background: $control-bg;
    color: $control-fg;
    border: solid $control-border;
    padding: 0 1;

    & > .input--placeholder,
    & > .input--suggestion {
        color: $control-placeholder-fg;
    }

    & > .input--cursor {
        background: $selected-bg;
        color: $selected-fg;
    }

    & > .input--selection {
        background: $selected-bg;
        color: $selected-fg;
    }

    &:hover {
        background: $control-hover-bg;
        color: $control-hover-fg;
    }

    &:focus {
        background: $control-focus-bg;
        background-tint: transparent;
        color: $control-focus-fg;
        border: solid $control-focus-border;
    }

    &.-invalid {
        border: solid $control-invalid-border;
    }

    &.-invalid:focus {
        border: solid $control-invalid-border;
    }

    &:disabled {
        background: $control-disabled-bg;
        color: $control-disabled-fg;
        opacity: 0.5;
        pointer: not-allowed;
    }
}

Select {
    color: $control-fg;

    & > SelectCurrent {
        background: $control-bg;
        color: $control-fg;
        border: solid $control-border;

        Static#label {
            color: $control-placeholder-fg;
        }

        &.-has-value Static#label {
            color: $control-fg;
        }

        .arrow {
            color: $control-placeholder-fg;
        }
    }

    &:focus > SelectCurrent {
        background: $control-focus-bg;
        color: $control-focus-fg;
        border: solid $control-focus-border;
    }

    & > SelectOverlay {
        background: $control-bg;
        color: $control-fg;
        border: solid $control-border;

        &:focus {
            border: solid $control-focus-border;
        }

        & > .option-list--option-highlighted {
            background: $selected-bg;
            color: $selected-fg;
        }

        & > .option-list--option-hover {
            background: $control-hover-bg;
            color: $control-hover-fg;
        }
    }
}

Checkbox {
    background: $control-bg;
    color: $control-fg;
    border: solid $control-border;

    /* Unchecked: the glyph matches its own background exactly, so it's
       invisible -- an empty-looking box reads as "off" far more clearly
       than a dim-but-still-visible X did next to a bright checked one. */
    & > .toggle--button {
        color: $control-bg;
        background: $control-bg;
    }

    &.-on > .toggle--button {
        color: $fg-accent;
        background: $control-bg;
    }

    & > .toggle--label {
        color: $control-fg;
    }

    &:hover {
        background: $control-hover-bg;
        color: $control-hover-fg;
    }

    &:focus {
        background: $control-focus-bg;
        color: $control-focus-fg;
        border: solid $control-focus-border;

        /* ToggleButton's own built-in `:focus > .toggle--label` rule (Textual's
           theme $block-cursor-background/-foreground, blue by default) is more
           specific than a bare Checkbox:focus color reassignment -- override the
           label directly so focus doesn't fall back to that blue highlight. */
        & > .toggle--label {
            color: $control-focus-fg;
            background: $control-focus-bg;
        }
    }
}

/* One identity color drives text + border together in every state except pressed
   (text goes transparent, border/background both become the identity color) and
   disabled (both become $fg-muted, overriding whichever variant it was -- disabled
   shouldn't still be signaling "this is the important one"). Hover and focus are
   identical: a 50%-alpha wash of the identity color over whatever's underneath. */
Button {
    width: auto;
    min-width: 8;
    height: 3;
    min-height: 3;
    padding: 0;

    background: $button-bg;
    background-tint: transparent;
    color: $button-fg;
    border: solid $button-fg;
    text-style: none;
    tint: transparent;
    pointer: pointer;

    &:hover {
        background: $button-fg 50%;
        color: $button-fg;
        border: solid $button-fg;
    }

    &:focus {
        background: $button-fg 50%;
        background-tint: transparent;
        color: $button-fg;
        border: solid $button-fg;
        text-style: none;
    }

    &.-active {
        background: $button-fg;
        color: transparent;
        border: solid $button-fg;
        tint: transparent;
    }

    &:disabled {
        background: $button-bg;
        color: $fg-muted;
        border: solid $fg-muted;
        opacity: 1;
        text-opacity: 1;
        text-style: none;
        pointer: not-allowed;
    }

    &.-primary {
        color: $button-primary-fg;
        border: solid $button-primary-fg;

        &:hover {
            background: $button-primary-fg 50%;
            color: $button-primary-fg;
            border: solid $button-primary-fg;
        }

        &:focus {
            background: $button-primary-fg 50%;
            background-tint: transparent;
            color: $button-primary-fg;
            border: solid $button-primary-fg;
        }

        &.-active {
            background: $button-primary-fg;
            color: transparent;
            border: solid $button-primary-fg;
            tint: transparent;
        }

        &:disabled {
            color: $fg-muted;
            border: solid $fg-muted;
        }
    }
}

/* ******************************** */
/*        shared data tables        */
/* ******************************** */

.tablesage-table {
    width: 1fr;
    height: 1fr;
    background: transparent;

    & > .datatable--header {
        background: $surface-3-bg;
        color: $fg-accent;
        text-style: bold;
    }

    & > .datatable--odd-row {
        background: $surface-2-bg;
        color: $surface-2-fg;
    }

    & > .datatable--even-row {
        background: $surface-1-bg;
        color: $surface-2-fg;
    }

    & > .datatable--cursor {
        background: $selected-bg;
        color: $selected-fg;
    }
}

/* ******************************** */
/*              dialogs             */
/* ******************************** */

ConfirmationDialog,
TextInputDialog,
PlayerPickerDialog,
RolePickerDialog,
GlossaryEntryDialog,
ProgressDialog,
AttendeeDialog,
SessionFromCampaignPickerDialog,
ManualReviewUtteranceDialog,
SpeakerResolutionDialog,
TranscriptViewDialog,
FindReplaceDialog {
    align: center middle;
    background: $overlay-bg;

    #confirmation-dialog,
    #text-input-dialog,
    #player-picker-dialog,
    #role-picker-dialog,
    #glossary-entry-dialog,
    #progress-dialog,
    #attendee-dialog,
    #session-picker-dialog,
    #manual-review-utterance-dialog,
    #speaker-resolution-dialog,
    #transcript-view-dialog,
    #find-replace-dialog {
        width: 60;
        height: auto;
        background: $pine-750;
        color: $surface-2-fg;
        border: solid $surface-border;
        padding: 1 2;

        border-title-align: left;
        border-title-color: $fg-accent;
        border-title-style: bold;
    }

    #attendee-dialog,
    #session-picker-dialog,
    #manual-review-utterance-dialog,
    #speaker-resolution-dialog {
        width: 90;
    }

    #manual-review-utterance-dialog .field-row {
        height: 3;
        align: left middle;

        .field-label {
            width: 12;
        }

        Select {
            width: 1fr;
        }
    }

    #find-replace-dialog .field-row {
        height: 3;
        align: left middle;

        .field-label {
            width: 12;
        }

        Input {
            width: 1fr;
        }
    }

    #find-replace-dialog Checkbox {
        margin: 0 0 1 0;
    }

    #transcript-view-dialog {
        width: 120;
    }

    #confirmation-prompt,
    #text-input-prompt,
    #session-enhancement-scope-prompt,
    #role-picker-prompt,
    #player-picker-empty,
    #attendee-empty,
    #session-picker-empty,
    #progress-message {
        height: auto;
        margin: 0 0 1 0;
    }

    #session-picker-campaign-row {
        height: 3;
        align: left middle;
        margin: 0 0 1 0;

        .field-label {
            width: 8;
        }

        Select {
            width: 1fr;
        }
    }

    #session-picker-table {
        height: 12;
        margin: 0 0 1 0;
    }

    #progress-bar {
        width: 1fr;
        height: 1;

        Bar {
            width: 1fr;
        }
    }

    #player-picker-table {
        height: 12;
        margin: 0 0 1 0;
    }

    #attendee-player-row,
    #attendee-name-row {
        height: 3;
        align: left middle;
        margin: 0 0 1 0;

        .field-label {
            width: 16;
        }

        Select,
        Input {
            width: 1fr;
        }
    }

    #attendee-role-table {
        height: 8;
        margin: 0 0 1 0;
    }

    #attendee-role-actions {
        width: 1fr;
        height: auto;
        margin: 0 0 1 0;

        Button {
            margin: 0 1 0 0;
        }

        #attendee-role-actions-add {
            width: 1fr;
            height: auto;
        }

        #attendee-role-actions-edit {
            width: auto;
            height: auto;
            dock: right;
        }
    }

    #speaker-resolution-player-row,
    #speaker-resolution-name-row,
    #speaker-resolution-status-row {
        height: 3;
        align: left middle;
        margin: 0 0 1 0;

        .field-label {
            width: 16;
        }

        Select,
        Input {
            width: 1fr;
        }
    }

    #transcript-view-table {
        height: 20;
        margin: 0 0 1 0;
    }

    .field-label {
        height: 1;
        color: $fg-muted;
        margin: 0 0 0 0;
    }

    .section-title {
        height: 1;
        margin: 0 0 1 0;
        color: $fg-accent;
        text-style: bold;
    }

    Input {
        margin: 0 0 1 0;
    }

    .dialog-actions {
        height: auto;
        align: right middle;

        Button {
            margin: 1 0 0 1;
        }
    }
}

/* ******************************** */
/*   filesystem picker (fspicker)   */
/* ******************************** */

FileOpen,
FileSave,
SelectDirectory {
    align: center middle;
    background: $overlay-bg;

    Dialog {
        width: 70%;
        height: 80%;
        background: $pine-750;
        color: $surface-2-fg;
        border: solid $surface-border;
        padding: 1 2;

        border-title-align: left;
        border-title-color: $fg-accent;
        border-title-style: bold;
        border-subtitle-color: $fg-danger;
        border-subtitle-background: $pine-750;
    }

    CurrentDirectory {
        background: transparent;
        color: $fg-muted;
        border-bottom: solid $surface-border;
        margin: 0 0 1 0;
    }

    DirectoryNavigation {
        background: transparent;
        border: blank;

        scrollbar-background: $surface-2-bg;
        scrollbar-background-hover: $surface-3-bg;
        scrollbar-background-active: $surface-3-bg;
        scrollbar-color: $sage-700;
        scrollbar-color-hover: $sage-600;
        scrollbar-color-active: $sage-400;
        scrollbar-corner-color: $surface-2-bg;

        & > .directory-navigation--hidden {
            color: $fg-muted;
            text-style: italic;
        }

        & > .option-list--option-highlighted {
            background: $selected-bg;
            color: $selected-fg;
        }

        & > .option-list--option-hover {
            background: $control-hover-bg;
            color: $control-hover-fg;
        }
    }

    InputBar {
        height: auto;
        align: right middle;
        padding: 1 0 0 0;

        Input {
            background: $control-bg;
            color: $control-fg;
            border: solid $control-border;

            &:focus {
                background: $control-focus-bg;
                color: $control-focus-fg;
                border: solid $control-focus-border;
            }
        }

        Button {
            margin: 0 0 0 1;
        }
    }
}

/* ******************************** */
/*          notifications           */
/* ******************************** */

Toast {
    background: $pine-750;
    color: $surface-2-fg;
    border-left: outer $surface-border;
}

.toast--title {
    color: $surface-2-fg;
}

Toast.-information {
    border-left: outer $fg-accent;
}

Toast.-information .toast--title {
    color: $fg-accent;
}

Toast.-warning {
    border-left: outer $fg-warning;
}

Toast.-warning .toast--title {
    color: $fg-warning;
}

Toast.-error {
    border-left: outer $fg-danger;
}

Toast.-error .toast--title {
    color: $fg-danger;
}

/* ******************************** */
/*         landing screen           */
/* ******************************** */

LandingScreen {
    .screen-body {
        align: center middle;
    }

    /* Quit (^Q) is only shown in this screen's footer -- see landing.py's
       BINDINGS -- and stays right-docked here, unlike every other screen's
       footer which just flows left-to-right. */
    Footer FooterKey:last-child {
        dock: right;
    }

    #welcome-panel {
        width: 80;
        height: 31;

        #welcome-content {
            width: 100%;
            height: 100%;
            align: center top;
        }

        #welcome-lockup {
            width: auto;
            height: auto;
            margin: 0;

            layout: grid;
            grid-size: 2 2;
            grid-columns: auto auto;
            grid-rows: auto 6;

            #logo-spacer {
                width: auto;
                height: auto;
            }

            #welcome-logo {
                width: 100%;
                height: auto;

                /* content-align stays left so the art's own internal shape
                   (each line's relative indent) isn't distorted by per-line
                   justification; padding-left instead shifts the whole block
                   right so its widest line (17 cols) meets the box's right
                   edge (23 cols, set by sage-wordmark's width below). */
                content-align: left middle;
                padding-left: 6;
                text-wrap: nowrap;
                padding-bottom: 1;
                padding-top: 1;
            }

            #table-wordmark,
            #sage-wordmark {
                width: auto;
                height: 6;

                content-align: left bottom;
                text-wrap: nowrap;
            }

            #table-wordmark {
                color: $fg-accent;
                
            }

            #sage-wordmark {
                color: $surface-2-fg;
            }
        }

        #welcome-tagline {
            width: auto;
            height: 1;
            margin: 1 0 0 0;
            color: $fg-muted;
        }

        #welcome-divider {
            width: auto;
            height: 1;
            margin: 1 0;
            color: $surface-border;
            text-wrap: nowrap;
        }

        #welcome-actions {
            width: auto;
            height: auto;
            margin-top: 2;
        }

        .call-to-action {
            width: auto;
            height: 1;
            content-align: left middle;
            align: left middle;
            margin-top: 1;
        }

        #show-campaigns-command {
            margin-top: 0;
        }

    }
}

/* ******************************** */
/*        campaign list screen      */
/* ******************************** */

CampaignListScreen {
    .screen-body {
        padding: 1 2;
    }

    #campaign-list-panel {
        width: 1fr;
        height: 1fr;
    }

    #campaign-table {
        width: 1fr;
        height: 1fr;
        background: transparent;

        & > .datatable--header {
            background: $surface-3-bg;
            color: $fg-accent;
            text-style: bold;
        }

        & > .datatable--odd-row {
            background: $surface-2-bg;
            color: $surface-2-fg;
        }

        & > .datatable--even-row {
            background: $surface-1-bg;
            color: $surface-2-fg;
        }

        & > .datatable--cursor {
            background: $selected-bg;
            color: $selected-fg;
        }
    }
}

/* ******************************** */
/*        players list screen       */
/* ******************************** */

PlayersListScreen {
    .screen-body {
        padding: 1 2;
    }

    #players-list-panel {
        width: 1fr;
        height: 1fr;
    }

    #players-table {
        width: 1fr;
        height: 1fr;
        background: transparent;

        & > .datatable--header {
            background: $surface-3-bg;
            color: $fg-accent;
            text-style: bold;
        }

        & > .datatable--odd-row {
            background: $surface-2-bg;
            color: $surface-2-fg;
        }

        & > .datatable--even-row {
            background: $surface-1-bg;
            color: $surface-2-fg;
        }

        & > .datatable--cursor {
            background: $selected-bg;
            color: $selected-fg;
        }
    }
}

/* ******************************** */
/*       campaign detail screen     */
/* ******************************** */

CampaignDetailScreen {
    .screen-body {
        padding: 1 2;
    }

    #campaign-detail-panel {
        width: 1fr;
        height: 1fr;
        layout: vertical;
    }

    #campaign-metadata {
        height: auto;
        margin: 0 0 1 0;

        .field-row {
            height: 3;
            align: left middle;
            margin: 0 0 1 0;

            .field-label {
                width: 14;
                height: 1;
                color: $fg-muted;
            }

            Input {
                width: 1fr;
            }
        }
    }

    #campaign-detail-tabs {
        height: 1;
        margin: 0 0 1 0;

        .tab-label {
            width: auto;
            height: 1;
            margin: 0 2 0 0;
            color: $fg-muted;
            pointer: pointer;

            &:hover {
                color: $control-hover-fg;
            }

            &.-active {
                color: $fg-accent;
                text-style: bold;
            }
        }
    }

    #campaign-detail-switcher {
        width: 1fr;
        height: 1fr;
    }
}

/* ******************************** */
/*        player detail screen      */
/* ******************************** */

PlayerDetailScreen {
    .screen-body {
        padding: 1 2;
    }

    #player-detail-panel {
        width: 1fr;
        height: 1fr;
        layout: vertical;
    }

    #player-metadata {
        height: auto;
        margin: 0 0 2 0;

        .field-row {
            height: 3;
            align: left middle;
            margin: 0 0 1 0;

            .field-label {
                width: 14;
                height: 1;
                color: $fg-muted;
            }

            Input {
                width: 1fr;
            }
        }

        #player-stats-row {
            height: 1;
            align: left middle;
            /* Inset 1 column in from the Name input's edges on both sides
               (left offset = its label column width + 1, right offset = 1),
               so the row reads as gently nested inside the input's bounds
               rather than flush with them. */
            margin: 0 1 0 15;

            .field-label {
                width: auto;
                margin: 0 1 0 0;
            }

            .field-value {
                width: auto;
                color: $surface-2-fg;
            }

            /* Flexible gaps between label-value pairs: whatever width is left
               after the (fixed-width) labels/values distributes evenly here,
               so the row's content spans exactly as wide as the Name input
               (same start, same end) regardless of terminal width. */
            .field-spacer {
                width: 1fr;
            }
        }
    }

    .section-title {
        height: 1;
        margin: 0 0 1 0;
        color: $fg-accent;
        text-style: bold;
    }
}

/* ******************************** */
/*       session detail screen      */
/* ******************************** */

SessionDetailScreen {
    .screen-body {
        padding: 1 2;
    }

    #session-detail-panel {
        width: 1fr;
        height: 1fr;
        layout: vertical;
    }

    #session-metadata {
        height: auto;
        margin: 0 0 2 0;

        .field-row {
            height: 3;
            align: left middle;
            margin: 0 0 1 0;

            .field-label {
                width: 14;
                height: 1;
                color: $fg-muted;
            }

            Input {
                width: 1fr;
            }

            .field-value {
                width: 1fr;
                color: $surface-2-fg;
            }
        }
    }

    .section-title {
        height: 1;
        margin: 0 0 1 0;
        color: $fg-accent;
        text-style: bold;
    }

    #session-detail-body {
        width: 1fr;
        height: 1fr;
    }

    #session-attendance-column {
        width: 1fr;
        height: 1fr;
        margin: 0 4 0 0;
    }

    #attendance-section {
        height: 2fr;
    }

    #errors-section {
        height: 1fr;
        margin: 1 0 0 0;
    }

    #attendance-table {
        /* Long, comma-separated role lists should clip, not grow a
           horizontal scrollbar -- there's no way to scroll a DataTable
           column of unbounded width and it's not worth adding one for this. */
        overflow-x: hidden;
    }

    #error-table {
        overflow-x: hidden;
    }

    #session-indicators-column {
        width: 34;
        height: 1fr;
    }

    #artifacts-panel {
        height: 1fr;
        padding: 1 2;
        border: solid $surface-border;

        Static {
            height: auto;
            margin: 0 0 1 0;

            &.artifact-missing {
                color: $fg-muted;
            }
        }
    }
}

/* ******************************** */
/*       manual review screen       */
/* ******************************** */

ManualReviewScreen {
    .screen-body {
        padding: 1 2;
    }

    #manual-review-panel {
        width: 1fr;
        height: 1fr;
        layout: vertical;
    }

    #manual-review-status {
        height: 1;
        margin: 0 0 1 0;

        Static {
            width: auto;
            margin: 0 3 0 0;
            color: $fg-accent;
            text-style: bold;
        }
    }

    #manual-review-legend {
        height: 1;
        margin: 0 0 1 0;
        color: $fg-muted;
    }

    #manual-review-table {
        height: 1fr;
    }

    #manual-review-actions {
        height: auto;
        margin: 1 0 0 0;

        Button {
            margin: 0 0 0 1;
        }
    }
}

/* ******************************** */
/*  player import from audio wizard */
/* ******************************** */

PlayerImportPreStepScreen {
    /* The source filename is a static context line, not an actionable heading --
       muted color plus an extra blank line below it distinguishes it from the list's
       own bold/accent title, which names what the box below it actually does. */
    #player-import-source {
        height: 1;
        margin: 0 0 2 1;
        color: $fg-muted;
    }

    .section-title {
        height: 1;
        margin: 0 0 1 1;
        color: $fg-accent;
        text-style: bold;
    }

    #player-import-candidates-table {
        height: 14;
        margin: 0 0 1 0;
        border: solid $surface-border;
    }

    .dialog-actions {
        height: auto;

        #player-import-continue {
            /* Docked (not "align: right middle" on the row) so the clean-audio
               checkbox can sit at the row's left instead of bunching up beside it. */
            dock: right;
        }
    }
}
