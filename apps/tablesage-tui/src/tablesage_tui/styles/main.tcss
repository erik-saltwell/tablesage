$bg:        #0f1411; 
$panel-bg:  #1a201c;  /* bordered panel fill           */
$border:    #2a342d;  /* panel + footer hairlines      */
$bg-focus:  #222a25;  /* halfway between panel-bg + border */
$bg-focus-subtle: #1e2520; 
$cream-fg:      #d6d1bf;  /* warm cream body text          */
$dim:       #7c8478;  /* secondary / hint copy         */
$sage:      #a3b88c;  /* primary sage green            */
$sage-deep: #6f8a5a;  /* header bar fill               */
$sage-glow: rgba(163, 184, 140, 0.45);
$accent:    #d8b06a;  /* footer keycaps, key chips     */
$panel-bg-muted: #1a201cbb;
$accent-soft: #d7c195; /* halfway between cream-fg and accent */
$accent-cream: #d7c9aa; /* halfway between $accent-soft and $cream-fg*/

* {
    margin: 0;
    padding: 0;
}

Screen {
    background: $bg;
}

.keycap{
    width: 3;
    height: 1;
    min-height:1;
    min-width:3;
    background: $accent;
    color: $panel-bg;
    text-style: bold;
    content-align: center middle;
}

CommandButton {
    width: auto;
    height: 1;
    min-height: 1;
    padding: 0 1;
    color: $sage-deep;
    background: transparent;
    content-align: center middle;
    pointer: pointer;

    Static {
        width: auto;
        height: 1;
    }
}

CommandButton:hover,
CommandButton:focus {
    background: $bg-focus;
    color: $cream-fg;
}

CommandButton:hover .keycap,
CommandButton:focus .keycap {
    background: $accent-cream;
    color: $bg;
}

CommandButton.-active {
    background: $sage-deep;
    color: $bg;
}

CommandButton.-active .keycap {
    background: $panel-bg;
    color: $accent;
}

CommandButton:disabled {
    color: $dim;
    text-opacity: 60%;
    pointer: not-allowed;
}

CommandButton:disabled .keycap {
    background: $border;
    color: $dim;
}

Footer {
    background: $panel-bg;
    row-span: 1;
    column-span: 3;
}


TableSageHeader {
    height: 1;
    row-span: 1;
    column-span: 3;
    background: $sage-deep;
    color: $panel-bg-muted;
    layout: horizontal;

    .brand-panel{
        width:1fr;
        align: left middle;
        
        * {
            width:auto;
            margin: 0 0 0 2;
        }
        .brand{
            margin: 0 0 0 2;
            text-style: bold;
            color: $bg;
        }
    }
    .info-panel{
        width:1fr;
        align: right middle;
        * {
            width: auto;
            margin: 0 2 0 0;
        }
        .clock{

        }
    }
}




